[Unit]
Description=CArtei tenant management system
Requires=network-online.target cartei-db.service
After=network-online.target cartei-db.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/tank/cartei
ExecStart=/usr/bin/podman compose up -d
ExecStop=/usr/bin/podman compose down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
