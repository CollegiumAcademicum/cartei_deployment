# cartei_vision worker (DB VM). Loaded by the quadlet via EnvironmentFile.
# setup-db.sh writes this file automatically if it's missing; copy from here to
# customize. Set the cartei_vision role password before the nightly run:
#     podman exec -i cartei_postgres_1 psql -U cartei cartei \
#       -c "ALTER ROLE cartei_vision LOGIN PASSWORD 'CHANGE_ME';"
# The role itself is created by a cartei_db migration (runs from the app VM).

# Least-privilege role, connecting to Postgres on the same host.
DATABASE_URL=postgresql+psycopg://cartei_vision:CHANGE_ME@localhost:5432/cartei

# Optional: only if you rotate trust anchors without rebuilding the image.
# They're baked into the image by default, so leave this unset normally.
#CARTEI_VISION_TRUST_DIR=/etc/cartei-vision/trust
