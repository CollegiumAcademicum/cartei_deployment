# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=cartei
POSTGRES_USER=cartei
POSTGRES_PASSWORD=CHANGE_ME

# Used by both the migrate container (Alembic) and the app container (Django)
# Replace db.intranet.ca-hd.de with the actual hostname/IP of the DB VM
DATABASE_URL=postgresql+psycopg://cartei:CHANGE_ME@db.intranet.ca-hd.de:5432/cartei

# ── Backups (DB VM only) ──────────────────────────────────────────────────────
# age recipient PUBLIC key. Generate the keypair OFFLINE on your workstation:
#     age-keygen -o cartei-backup-key.txt
# Keep cartei-backup-key.txt in a password manager — it must NOT live on the
# server. Copy the "public key: age1..." value below. REQUIRED: backups refuse
# to run if this is empty.
AGE_RECIPIENT=
# Cloudflare R2 upload via rclone. Empty R2_REMOTE = keep local backups only.
# Configure the remote once (see operations.md); RCLONE_CONFIG points at it.
R2_REMOTE=r2:cartei-backups
RCLONE_CONFIG=/var/lib/cartei/rclone.conf
BACKUP_RETENTION_DAYS=90

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=CHANGE_ME
DEBUG=false
ALLOWED_HOSTS=cartei.intranet.ca-hd.de
HTTPS_ENABLED=true
CSRF_TRUSTED_ORIGINS=https://cartei.intranet.ca-hd.de

# ── LDAP (FreeIPA) ────────────────────────────────────────────────────────────
LDAP_SERVER_URI=ldaps://ipa.intranet.ca-hd.de
LDAP_BIND_DN=uid=service_cartei,cn=users,cn=accounts,dc=intranet,dc=ca-hd,dc=de
LDAP_BIND_PASSWORD=CHANGE_ME
LDAP_USER_SEARCH_BASE=cn=users,cn=accounts,dc=intranet,dc=ca-hd,dc=de
LDAP_CA_CERT_PATH=/app/certs/ca.pem
LDAP_REQUIRE_GROUP=cn=confidentiality_clearance,cn=groups,cn=accounts,dc=intranet,dc=ca-hd,dc=de
LDAP_GROUPS_BASE=cn=groups,cn=accounts,dc=intranet,dc=ca-hd,dc=de

# ── FreeIPA provisioning (app VM) ─────────────────────────────────────────────
# CArtei creates tenant accounts via the IPA JSON-RPC API. Use a DEDICATED
# FreeIPA *user* account (password auth), separate from the read-only bind above,
# holding only the "CArtei Provisioner" role (add user + write mail — see
# operations.md). Empty IPA_SERVER disables provisioning. IPA_SERVER is a bare
# hostname (no scheme).
IPA_SERVER=ipa.intranet.ca-hd.de
IPA_PROVISION_USER=svc-cartei
IPA_PROVISION_PASSWORD=CHANGE_ME
IPA_VERIFY_SSL=true

# ── Role groups ───────────────────────────────────────────────────────────────
CARTEI_ADMIN_GROUP=cn=cartei_admin,cn=groups,cn=accounts,dc=intranet,dc=ca-hd,dc=de
CARTEI_CLUSTER_GROUP=cn=gr.cluster,cn=groups,cn=accounts,dc=intranet,dc=ca-hd,dc=de
CARTEI_MIETVERWALTUNG_GROUP=cn=cartei_mietverwaltung,cn=groups,cn=accounts,dc=intranet,dc=ca-hd,dc=de

# Tenant-view section access: which Django group name(s) grant each role.
# These are the group names as synced from LDAP (cluster → "gr.cluster"; the
# cartei_* rights groups keep their raw cn). Comma-separated for multiple.
# Defaults shown; override the Finanzierung cn once the real group exists.
TENANT_GROUP_CLUSTER=gr.cluster
TENANT_GROUP_MIETVERWALTUNG=cartei_mietverwaltung
TENANT_GROUP_FINANZIERUNG=ag.finanzierung

# --- cartei_vision worker (separate least-privilege DB role) ---
# Create the role password once on the DB VM:
#   psql -c "ALTER ROLE cartei_vision LOGIN PASSWORD 'CHANGE_ME';"
# Then put its own DATABASE_URL in /var/lib/cartei/vision.env:
#   DATABASE_URL=postgresql+psycopg://cartei_vision:CHANGE_ME@localhost:5432/cartei
